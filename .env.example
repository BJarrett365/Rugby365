DATABASE_URL=postgresql://rugby365:rugby365@localhost:5433/rugby365
OPERATOR_PASSWORD=rugby365-dev
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Rugby Data API (PRIMARY feed — server-only; never NEXT_PUBLIC_*)
# Optional token: paste Postman `token` header value here, or save via /admin/keys/rugby-data
# GETs currently work without a token when the API allows anonymous browser UA.
# RUGBY_DATA_API_BASE_URL=https://cms-planetrugby-players-investigator-for-barrie.hneeds.com
# RUGBY_DATA_API_TOKEN=

# Supabase (optional — also configurable at /admin/keys/supabase)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # server-only; never NEXT_PUBLIC_*
# NEXT_PUBLIC_SUPABASE_URL=    # only if a browser client needs the project URL
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Wikimedia Enterprise (read-only Wikipedia archive import — optional; public API fallback)
# WIKIMEDIA_ENTERPRISE_USERNAME=
# WIKIMEDIA_ENTERPRISE_PASSWORD=
# OPENAI_API_KEY=          # optional — CMS Admin → Keys → OpenAI also stores a key
# OPENAI_MODEL=gpt-4o-mini # optional — overrides CMS default model when set
