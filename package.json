{
  "name": "rugby365",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/ensure-db.cjs && npm run dev -w @rugby365/web",
    "dev:kill-port": "lsof -tiTCP:3000 -sTCP:LISTEN | xargs kill 2>/dev/null || true",
    "dev:restart": "npm run dev:kill-port && rm -rf apps/web/.next apps/web/node_modules/.cache/rugby365-next && NEXT_DIST_DIR=node_modules/.cache/rugby365-next npm run dev -w @rugby365/web",
    "dev:restart:full": "npm run dev:kill-port && rm -rf apps/web/.next && node scripts/ensure-db.cjs && npm run dev -w @rugby365/web",
    "prebuild": "node scripts/prebuild-safe.cjs",
    "build": "npm run build -w @rugby365/web",
    "db:generate": "npm run generate -w @rugby365/db",
    "db:up": "node scripts/ensure-db.cjs",
    "db:check": "node scripts/db-check.mjs",
    "db:migrate": "npm run migrate -w @rugby365/db",
    "db:seed": "npm run seed -w @rugby365/db",
    "bootstrap:data": "tsx --require ./scripts/stub-server-only.cjs scripts/bootstrap-project-data.ts",
    "capture:rugby-data": "tsx --require ./scripts/stub-server-only.cjs scripts/capture-rugby-data-to-project.ts",
    "import:rugby-data:discover": "tsx --require ./scripts/stub-server-only.cjs scripts/import-rugby-data-all.ts discover",
    "import:rugby-data:all": "tsx --require ./scripts/stub-server-only.cjs scripts/import-rugby-data-all.ts import-all-leagues",
    "import:rugby-data:enrich": "tsx --require ./scripts/stub-server-only.cjs scripts/import-rugby-data-all.ts enrich-matches",
    "import:rugby-data:coverage": "tsx --require ./scripts/stub-server-only.cjs scripts/import-rugby-data-all.ts coverage-report",
    "pull:rugby-data": "tsx --require ./scripts/stub-server-only.cjs scripts/pull-rugby-data-all.ts pull",
    "pull:rugby-data:report": "tsx --require ./scripts/stub-server-only.cjs scripts/pull-rugby-data-all.ts report",
    "import:wikipedia:challenge-cup": "tsx --require ./scripts/stub-server-only.cjs scripts/import-wikipedia-challenge-cup-seasons.ts",
    "import:wikipedia:champions-cup": "tsx --require ./scripts/stub-server-only.cjs scripts/import-wikipedia-champions-cup-seasons.ts",
    "import:wikipedia:rugby-championship": "tsx --require ./scripts/stub-server-only.cjs scripts/import-wikipedia-rugby-championship-seasons.ts",
    "import:wikipedia:currie-cup": "tsx --require ./scripts/stub-server-only.cjs scripts/import-wikipedia-currie-cup-seasons.ts",
    "import:sa-pathway": "tsx --require ./scripts/stub-server-only.cjs scripts/import-sa-pathway.ts",
    "import:wikipedia:nh-internationals": "tsx --require ./scripts/stub-server-only.cjs scripts/import-wikipedia-northern-hemisphere-internationals.ts",
    "import:wikipedia:top-14": "tsx --require ./scripts/stub-server-only.cjs scripts/import-wikipedia-top-14-seasons.ts",
    "import:wikipedia:super-rugby": "tsx --require ./scripts/stub-server-only.cjs scripts/import-wikipedia-super-rugby-seasons.ts",
    "import:wikipedia:rfu-championship": "tsx --require ./scripts/stub-server-only.cjs scripts/import-wikipedia-rfu-championship-seasons.ts",
    "import:wikipedia:nations-championship": "tsx --require ./scripts/stub-server-only.cjs scripts/import-wikipedia-nations-championship.ts",
    "scrape:rwc": "tsx scripts/scrape-rugby-world-cup.ts",
    "scrape:rwc:rdb": "tsx scripts/scrape-rugbydatabase-rwc.ts",
    "import:scraped:rwc": "tsx --require ./scripts/stub-server-only.cjs scripts/import-scraped-rugby-world-cup.ts",
    "import:rwc:rdb": "tsx --require ./scripts/stub-server-only.cjs scripts/import-rugbydatabase-rwc.ts",
    "sync:rwc:player-stats": "tsx --require ./scripts/stub-server-only.cjs scripts/sync-rwc-fixture-player-performance.ts",
    "sync:rwc:scoring-events": "tsx --require ./scripts/stub-server-only.cjs scripts/apply-rwc-scoring-events-to-stats.ts",
    "sync:rwc:team-stats": "tsx --require ./scripts/stub-server-only.cjs scripts/sync-rwc-team-match-stats-from-players.ts",
    "import:rwc:opta-leaders": "tsx --require ./scripts/stub-server-only.cjs scripts/import-rwc-opta-leaderboards.ts",
    "estimate:rwc:historical-stats": "tsx --require ./scripts/stub-server-only.cjs scripts/estimate-rwc-historical-player-stats.ts",
    "backfill:rwc:historical-stats": "tsx --require ./scripts/stub-server-only.cjs scripts/backfill-rwc-historical-player-stats.ts",
    "backfill:rwc:totw": "tsx --require ./scripts/stub-server-only.cjs scripts/backfill-rwc-team-of-the-week.ts",
    "scrape:rwc:wiki-stats": "tsx scripts/scrape-wikipedia-rwc-statistics.ts",
    "import:rwc:wiki-stats": "tsx --require ./scripts/stub-server-only.cjs scripts/import-wikipedia-rwc-statistics.ts",
    "import:wikipedia:rwc-players": "tsx --require ./scripts/stub-server-only.cjs scripts/import-wikipedia-rwc-players.ts",
    "import:wikipedia:rwc": "tsx --require ./scripts/stub-server-only.cjs scripts/import-wikipedia-rugby-world-cup-seasons.ts",
    "import:wikipedia:npc": "tsx --require ./scripts/stub-server-only.cjs scripts/import-wikipedia-npc-seasons.ts",
    "import:competition-catalog": "tsx --require ./scripts/stub-server-only.cjs scripts/seed-and-import-competition-catalog.ts",
    "import:competition-previous-seasons": "tsx --require ./scripts/stub-server-only.cjs scripts/backfill-competition-previous-seasons.ts",
    "seed:competition-teams": "tsx --require ./scripts/stub-server-only.cjs scripts/seed-competition-season-teams.ts",
    "backfill:standing-form": "tsx --require ./scripts/stub-server-only.cjs scripts/backfill-standing-form.ts",
    "recompute:standing-form": "tsx --require ./scripts/stub-server-only.cjs scripts/recompute-standing-form.ts",
    "cleanup:junk-teams-form": "tsx --require ./scripts/stub-server-only.cjs scripts/cleanup-junk-teams-and-standing-form.ts",
    "cleanup:wiki-junk-teams": "tsx --require ./scripts/stub-server-only.cjs scripts/cleanup-wiki-junk-teams.ts",
    "merge:sa-franchises": "tsx --require ./scripts/stub-server-only.cjs scripts/merge-sa-franchise-teams.ts",
    "keys:check": "tsx --require ./scripts/stub-server-only.cjs scripts/check-integration-keys.ts",
    "import:wikipedia:major-gaps": "tsx --require ./scripts/stub-server-only.cjs scripts/import-major-season-gaps.ts",
    "enrich:rugbypass": "tsx --require ./scripts/stub-server-only.cjs scripts/enrich-players-rugbypass.ts",
    "enrich:rugbypass:all": "tsx --require ./scripts/stub-server-only.cjs scripts/enrich-players-rugbypass.ts --all --profiles-only --delay=400",
    "pull:player-images": "tsx --require ./scripts/stub-server-only.cjs scripts/pull-player-source-images.ts",
    "backfill:team-images": "tsx --require ./scripts/stub-server-only.cjs scripts/backfill-team-images-wikipedia.ts",
    "generate:cartoons": "tsx --require ./scripts/stub-server-only.cjs scripts/generate-cartoon-avatars.ts",
    "sync:cartoons": "tsx --require ./scripts/stub-server-only.cjs scripts/sync-cartoon-avatar-manifest.ts",
    "sync:supabase": "tsx scripts/sync-from-supabase.ts",
    "demo:feed": "node scripts/demo-live-match-feed.mjs",
    "agent:sandbox": "tsx scripts/agent-sandbox-run.ts",
    "agent:sandbox:live": "tsx scripts/agent-sandbox-run.ts --fixture=false --once=false --poll-interval=30",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.13",
    "sharp": "^0.35.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  }
}
